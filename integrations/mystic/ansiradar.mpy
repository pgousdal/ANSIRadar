"""Mystic GZ entry point for the native embedded-Python integration."""

import logging
import os
import sys

REPOSITORY_SRC = "/home/mystic/doors/ansiradar/site-packages"
LOG_PATH = "/home/mystic/doors/ansiradar/mystic.log"
if REPOSITORY_SRC not in sys.path:
    sys.path.insert(0, REPOSITORY_SRC)

import mystic_bbs as bbs  # noqa: E402


def _env(name, default):
    return os.environ.get(name, default)


def _env_bool(name, default):
    return _env(name, "1" if default else "0").casefold() in {"1", "true", "yes", "on"}


def main():
    from ansiradar.mystic import MysticConfig, build_mystic_engine, run_mystic
    from ansiradar.sources import SourceSpec

    source = _env("ANSIRADAR_SOURCE", "file")
    endpoint = _env("ANSIRADAR_FILE", "/home/mystic/doors/data/aircraft.json")
    lat = float(_env("ANSIRADAR_RECEIVER_LAT", "58.662"))
    lon = float(_env("ANSIRADAR_RECEIVER_LON", "6.717"))
    config = MysticConfig(
        range_nm=float(_env("ANSIRADAR_RANGE_NM", "100")),
        charset="ascii",
        restore_on_exit=_env_bool("ANSIRADAR_MYSTIC_RESTORE_ON_EXIT", True),
        flush_on_exit=_env_bool("ANSIRADAR_MYSTIC_FLUSH_ON_EXIT", False),
    )
    spec = SourceSpec(
        kind=source,
        file=endpoint if source == "file" else None,
        url=endpoint if source == "url" else None,
        replay_file=endpoint if source == "replay" else None,
    )
    resource_log = lambda event: logging.getLogger("ansiradar.mystic").info(event)
    build_stop_after = os.environ.get("ANSIRADAR_MYSTIC_BUILD_STOP_AFTER")
    engine, _radar_source = build_mystic_engine(
        spec,
        receiver_lat=lat,
        receiver_lon=lon,
        poll_interval=config.poll_interval,
        log=resource_log,
        stop_after=build_stop_after,
    )
    if build_stop_after:
        logging.getLogger("ansiradar.mystic").info(
            "build_probe_return stage=%s", build_stop_after
        )
    else:
        run_mystic(
            bbs,
            engine,
            config,
            log=lambda action: logging.getLogger("ansiradar.mystic").info(action),
        )
        logging.getLogger("ansiradar.mystic").info("run_mystic_returned")
    return None


try:
    logging.basicConfig(
        filename=LOG_PATH,
        level=logging.INFO,
        format="%(asctime)s %(message)s",
    )
    logging.info("startup")
    main()
    logging.info("main_return")
    logging.info("mpy_end")
except Exception:
    try:
        logging.exception("controlled failure")
        bbs.rwrite("\x1b[2J\x1b[HANSIRadar could not start. Check mystic.log.\x1b[0m")
    except Exception:
        pass
